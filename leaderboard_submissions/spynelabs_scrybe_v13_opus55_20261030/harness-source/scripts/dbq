#!/usr/bin/env python3
"""dbq <logical_db> "<query>" [--max N] [--save NAME]

Run a READ-ONLY query against one logical database of the environment's database config (multidb.py).
- SQL engines (postgres, sqlite, duckdb): pass SQL.
- MongoDB: pass JSON: {"collection": "...", "filter": {...}, "projection": {...}, "limit": N}
  or an aggregation: {"collection": "...", "pipeline": [ ... ]}   (no limit is applied unless you add one)
Prints a compact table (first --max rows, default 40) plus the total row count, and always saves the
FULL result to <working directory>/results/<NAME or auto>.parquet (load it in python3 with pandas.read_parquet).
Exit codes: 0 ok, 1 query error, 2 usage error.
Uses the same connection code as `from multidb import q` (one implementation, read-only, bounded by the harness
deadline); argument errors are reported, not raised; --save names are restricted to [A-Za-z0-9_.-].
"""
# Ported from harness/dab-untuned-sage/scripts/dbq (v6.3); module and paths generalised (multidb.py).
import os
import re
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))


def die(msg, code=1):
    print(msg)
    sys.exit(code)


def parse(argv):
    args, mx, save = [], 40, None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--max", "--save"):
            if i + 1 >= len(argv):
                die(f"dbq: {a} needs a value\n\n{__doc__}", 2)
            v = argv[i + 1]
            if a == "--max":
                try:
                    mx = max(0, int(v))
                except ValueError:
                    die(f"dbq: --max needs an integer, got {v!r}", 2)
            else:
                if not re.fullmatch(r"[A-Za-z0-9_.\-]{1,100}", v):
                    die(f"dbq: --save name must match [A-Za-z0-9_.-]{{1,100}}, got {v!r}", 2)
                save = v
            i += 2
            continue
        args.append(a)
        i += 1
    if len(args) != 2:
        die(__doc__, 2)
    return args[0], args[1], mx, save


def main():
    db, query, mx, save = parse(sys.argv[1:])
    import pandas as pd
    import multidb as mdb
    try:
        t = mdb._conf(db).get("type")
    except (ValueError, RuntimeError) as e:
        die(f"dbq: {e}", 2)
    t0 = time.time()
    try:
        if t in ("mongo", "mongodb"):
            docs = mdb._mongo_docs(mdb._conf(db), mdb._mongo_spec(query))
            df = pd.json_normalize(docs, max_level=0) if docs else pd.DataFrame()
        else:
            df = mdb.q(db, query)
    except Exception as e:  # noqa: BLE001  any driver error is reported to the caller, never a traceback
        die(f"QUERY ERROR ({t}): {type(e).__name__}: {str(e)[:1500]}")
    os.makedirs(mdb.results_dir(), exist_ok=True)
    name = save or f"q{int(time.time() * 1000) % 10 ** 9}"
    path = os.path.join(mdb.results_dir(), f"{name}.parquet")
    try:
        df.astype({col: str for col in df.columns if df[col].dtype == object}).to_parquet(path)
    except Exception:
        path = path.replace(".parquet", ".pkl")
        try:
            df.to_pickle(path)
        except Exception as e:  # noqa: BLE001
            path = f"(not saved: {type(e).__name__}: {str(e)[:200]})"
    pd.set_option("display.width", 220)
    pd.set_option("display.max_columns", 40)
    pd.set_option("display.max_colwidth", 80)
    print(df.head(mx).to_string(index=False) if len(df) else "(no rows)")
    print(f"[{len(df)} rows x {len(df.columns)} cols; {time.time() - t0:.1f}s; full result: {path}]")


if __name__ == "__main__":
    main()
